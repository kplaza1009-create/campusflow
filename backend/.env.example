# Copy to backend/.env and adjust. Never commit real secrets.

CAMPUSFLOW_ENVIRONMENT=development
CAMPUSFLOW_DATABASE_URL=postgresql+psycopg://campusflow:campusflow@localhost:5432/campusflow

# JSON list of browser origins allowed to send state-changing requests.
CAMPUSFLOW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production must use HTTPS-only cookies:
#   CAMPUSFLOW_SESSION_COOKIE_SECURE=true
#   CAMPUSFLOW_SESSION_COOKIE_NAME=__Host-cf_session
CAMPUSFLOW_SESSION_COOKIE_SECURE=false
CAMPUSFLOW_SESSION_COOKIE_SAMESITE=lax
CAMPUSFLOW_SESSION_IDLE_DAYS=7
CAMPUSFLOW_SESSION_ABSOLUTE_DAYS=30

CAMPUSFLOW_LOGIN_WINDOW_MINUTES=15
CAMPUSFLOW_LOGIN_MAX_FAILURES_PER_EMAIL=5
CAMPUSFLOW_LOGIN_MAX_FAILURES_PER_IP=30
CAMPUSFLOW_REGISTER_MAX_PER_IP_PER_HOUR=10

CAMPUSFLOW_LOG_LEVEL=INFO

# Tests create and drop their own database using this role (needs CREATEDB):
CAMPUSFLOW_TEST_ADMIN_URL=postgresql+psycopg://campusflow:campusflow@localhost:5432/postgres
