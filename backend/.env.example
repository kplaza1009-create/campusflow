# Copy to backend/.env and adjust. Never commit real secrets.

CAMPUSFLOW_ENVIRONMENT=development
CAMPUSFLOW_DATABASE_URL=postgresql+psycopg://campusflow:campusflow@localhost:5432/campusflow

# JSON list of browser origins allowed to send state-changing requests.
CAMPUSFLOW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production must use HTTPS-only cookies:
#   CAMPUSFLOW_SESSION_COOKIE_SECURE=true
#   CAMPUSFLOW_SESSION_COOKIE_NAME=__Host-cf_session
CAMPUSFLOW_SESSION_COOKIE_SECURE=false
CAMPUSFLOW_SESSION_COOKIE_SAMESITE=lax
CAMPUSFLOW_SESSION_IDLE_DAYS=7
CAMPUSFLOW_SESSION_ABSOLUTE_DAYS=30

CAMPUSFLOW_LOGIN_WINDOW_MINUTES=15
CAMPUSFLOW_LOGIN_MAX_FAILURES_PER_EMAIL=5
CAMPUSFLOW_LOGIN_MAX_FAILURES_PER_IP=30
CAMPUSFLOW_REGISTER_MAX_PER_IP_PER_HOUR=10

CAMPUSFLOW_LOG_LEVEL=INFO

# Behind a hosting proxy, how many proxies append to X-Forwarded-For (Render: 2).
# 0 uses the connection's own address, which is right for local development.
CAMPUSFLOW_TRUSTED_PROXY_HOPS=0

# Serve the built frontend from the API (production and the browser tests do this).
# CAMPUSFLOW_FRONTEND_DIST=../frontend/dist

# --- Reminder email -----------------------------------------------------------
# "capture" (default) saves emails to EMAIL_CAPTURE_DIR/captured-emails.jsonl and
# sends nothing. "resend" sends through Resend: set the API key below (a secret;
# never commit it). Without a verified domain, Resend only delivers to the address
# you signed up with, so list it in EMAIL_ALLOWED_RECIPIENTS.
CAMPUSFLOW_EMAIL_MODE=capture
CAMPUSFLOW_EMAIL_CAPTURE_DIR=.captured-email
# CAMPUSFLOW_RESEND_API_KEY=re_...
# CAMPUSFLOW_EMAIL_FROM=CampusFlow <onboarding@resend.dev>
# A JSON list or comma-separated; anyone else's reminders stay in the app.
# CAMPUSFLOW_EMAIL_ALLOWED_RECIPIENTS=you@example.com
CAMPUSFLOW_APP_URL=http://localhost:5173

# --- Reminder worker (python -m app.worker) -------------------------------------
CAMPUSFLOW_WORKER_POLL_SECONDS=30
CAMPUSFLOW_REMINDER_MAX_ATTEMPTS=5
CAMPUSFLOW_REMINDER_LEASE_MINUTES=5

# --- Shared demo account (python -m app.demo) -----------------------------------
CAMPUSFLOW_DEMO_ENABLED=true
CAMPUSFLOW_DEMO_RESET_UTC_HOUR=8
CAMPUSFLOW_DEMO_LOGINS_PER_IP_PER_HOUR=30

# Tests create and drop their own database using this role (needs CREATEDB):
CAMPUSFLOW_TEST_ADMIN_URL=postgresql+psycopg://campusflow:campusflow@localhost:5432/postgres
